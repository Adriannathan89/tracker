# Optional Compose overrides. Defaults below are for local development.
# For deployment, replace both secrets; use URL-safe DB password characters.
POSTGRES_USER=tracker
POSTGRES_DB=tracker
POSTGRES_PASSWORD=tracker
TOKEN_SECRET=tracker-local-development-secret-change-me
FRONTEND_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Optional Discord integration: all three values are required when token is set.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_USERNAME=Tracker
