# Local development only; Furnace loads backend/.env when run from backend/.
# Set this URL to your existing local PostgreSQL credentials.
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker
# Replace with: openssl rand -hex 32
TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PUBLIC_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
